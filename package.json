{
  "name": "spending-tracker",
  "version": "1.0.0",
  "description": "Single-user Telegram bot that parses free-text spend messages with an LLM and tracks them with tags",
  "type": "module",
  "scripts": {
    "dev": "tsx src/bot.ts",
    "build": "tsc",
    "start": "node dist/bot.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke:item-edit": "tsx scripts/smoke-item-edit.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GVal98/spending-tracker.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/GVal98/spending-tracker/issues"
  },
  "homepage": "https://github.com/GVal98/spending-tracker#readme",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.4.2",
    "grammy": "^1.46.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.4.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
